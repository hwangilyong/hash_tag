{
  "name": "ui-agent-locator",
  "version": "0.1.0",
  "description": "Select UI in a live React/Vite app and send exact source context to Codex or Claude Code without Storybook stories.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite.js",
    "./client": "./dist/client.js",
    "./bridge": "./dist/bridge.js"
  },
  "bin": { "ui-agent-locator": "./dist/bin.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "bridge": "node dist/bin.js"
  },
  "engines": { "node": ">=20" },
  "peerDependencies": { "vite": ">=5 <8" },
  "dependencies": {
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "magic-string": "^0.30.17",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.7",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
